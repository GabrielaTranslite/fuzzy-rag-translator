# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Qdrant settings
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tm_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL settings
POSTGRES_HOST=localhost   # host tools (seed, local app) use localhost; containers override to "db" in docker-compose
POSTGRES_PORT=5433       # host port mapped to the db container (avoids a local Postgres on 5432)
POSTGRES_DB=fuzzy_repair
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Grafana
GRAFANA_ADMIN_PASSWORD=admin_change_me
